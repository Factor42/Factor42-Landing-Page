---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cardGradient, tagColor, tagBg } from '../../lib/theme';

const all = await getCollection('blog', ({ data }) => !data.draft);
const featured = all.find((p) => p.data.featured);
const posts = all
  .filter((p) => !p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' });

const filters = [
  { cat: 'all', label: 'All Topics' },
  { cat: 'smb', label: 'Small Business' },
  { cat: 'industry', label: 'Industry Research' },
  { cat: 'ad-ops', label: 'Ad Operations' },
  { cat: 'ai', label: 'AI & Technology' },
  { cat: 'programmatic', label: 'Programmatic' },
  { cat: 'media', label: 'Media & Publishing' },
];
---
<BaseLayout
  title="The Factor42 Blog — Insights on Ad Operations, Digital Media & AI"
  description="Research, perspectives, and hard-won lessons from the team that's executed over half a million campaigns across the digital landscape."
>
  <main class="pt-20">
    <!-- Hero -->
    <section class="grid-bg py-16 px-6 relative overflow-hidden">
      <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full opacity-15 pointer-events-none" style="background:radial-gradient(circle,#0066FF,transparent 70%)"></div>
      <div class="max-w-4xl mx-auto text-center relative z-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-blue-600 mb-4">The Factor42 Blog</p>
        <h1 class="text-4xl sm:text-5xl font-bold mb-4 leading-tight font-display">
          Insights on <span class="gradient-text">Ad Operations,</span><br>Digital Media &amp; AI
        </h1>
        <p class="text-slate-500 text-base sm:text-lg max-w-xl mx-auto">Research, perspectives, and hard-won lessons from the team that's executed over half a million campaigns across the digital landscape.</p>
      </div>
    </section>

    {featured && (
      <section class="py-12 px-6">
        <div class="max-w-5xl mx-auto reveal">
          <a href={`/blog/${featured.id}`} class="featured-card grid lg:grid-cols-5 gap-0 block hover:no-underline">
            <div class="lg:col-span-2 min-h-56 flex items-center justify-center relative overflow-hidden" style="background:linear-gradient(135deg,#0052CC 0%,#0066FF 50%,#00B4D8 100%)">
              <div class="absolute inset-0 opacity-10" style="background-image:linear-gradient(rgba(255,255,255,.15) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.15) 1px,transparent 1px);background-size:30px 30px"></div>
              <div class="relative z-10 p-8 text-center">
                <p class="text-5xl font-black text-white mb-1 font-display">{featured.data.featuredStat}</p>
                <p class="text-blue-100 text-sm font-medium">{featured.data.featuredStatLabel}</p>
              </div>
            </div>
            <div class="lg:col-span-3 p-8 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-4 flex-wrap">
                  <span class="cat-pill" style="background:rgba(0,102,255,.1);color:#0066FF;">Featured</span>
                  <span class="cat-pill" style={`background:${tagBg(featured.data)};color:${tagColor(featured.data)};`}>{featured.data.category}</span>
                </div>
                <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3 leading-snug font-display">{featured.data.title}</h2>
                <p class="text-slate-500 text-sm leading-relaxed mb-5">{featured.data.description}</p>
              </div>
              <div class="flex items-center justify-between flex-wrap gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold text-white" style="background:linear-gradient(135deg,#0066FF,#00B4D8)">F42</div>
                  <div>
                    <p class="text-xs font-semibold text-gray-700">{featured.data.author}</p>
                    <p class="text-xs text-slate-400">{fmtDate(featured.data.date)} · {featured.data.readMinutes} min read</p>
                  </div>
                </div>
                <span class="text-sm font-semibold text-blue-600 flex items-center gap-1 hover:gap-2 transition-all">Read Article <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
              </div>
            </div>
          </a>
        </div>
      </section>
    )}

    <!-- Filter + grid -->
    <section class="pb-20 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-wrap gap-2 mb-10 reveal">
          {filters.map((f, i) => (
            <button class:list={['tag-pill', { active: i === 0 }]} data-cat={f.cat}>{f.label}</button>
          ))}
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="articles-grid">
          {posts.map((p) => (
            <article class="article-card reveal" data-cat={p.data.group}>
              <div class="article-img" style={`background:${cardGradient(p.data)}`}>
                <div class="text-center p-6">
                  <p class="text-3xl font-black text-white font-display">{p.data.cardStat}</p>
                  <p class="text-white text-xs mt-1 opacity-80">{p.data.cardStatLabel}</p>
                </div>
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-center gap-2 mb-3">
                  <span class="cat-pill" style={`background:${tagBg(p.data)};color:${tagColor(p.data)};`}>{p.data.category}</span>
                  <span class="text-xs text-slate-400">{p.data.readMinutes} min read</span>
                </div>
                <h3 class="font-bold text-gray-900 text-base mb-2 leading-snug font-display">{p.data.title}</h3>
                <p class="text-sm text-slate-500 leading-relaxed flex-1 mb-4">{p.data.description}</p>
                <div class="flex items-center justify-between mt-auto pt-4 border-t" style="border-color:rgba(0,102,255,.08)">
                  <div>
                    <p class="text-xs font-semibold text-gray-700">{p.data.author}</p>
                    <p class="text-xs text-slate-400">{fmtDate(p.data.date)}</p>
                  </div>
                  <a href={`/blog/${p.id}`} class="text-xs font-semibold text-blue-600 hover:underline flex items-center gap-1">Read <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div id="no-results" class="hidden text-center py-16">
          <svg class="mx-auto mb-4 opacity-30" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0066FF" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <p class="text-slate-500 font-medium">No articles in this category yet.</p>
          <button id="show-all" class="mt-3 text-blue-600 text-sm font-semibold hover:underline">Show all articles</button>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    // Scroll reveal
    const revealEls = document.querySelectorAll('.reveal');
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('revealed'); obs.unobserve(e.target); } });
    }, { threshold: 0, rootMargin: '0px 0px -40px 0px' });
    revealEls.forEach((el) => obs.observe(el));
    setTimeout(() => revealEls.forEach((el) => el.classList.add('revealed')), 400);

    // Category filter
    const pills = document.querySelectorAll('.tag-pill');
    const articles = document.querySelectorAll('#articles-grid .article-card');
    const noResults = document.getElementById('no-results');
    function setFilter(cat) {
      pills.forEach((p) => p.classList.toggle('active', p.dataset.cat === cat));
      let visible = 0;
      articles.forEach((a) => {
        const show = cat === 'all' || a.dataset.cat === cat;
        a.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      noResults.classList.toggle('hidden', visible > 0);
    }
    pills.forEach((p) => p.addEventListener('click', () => setFilter(p.dataset.cat)));
    document.getElementById('show-all').addEventListener('click', () => setFilter('all'));
  </script>
</BaseLayout>
