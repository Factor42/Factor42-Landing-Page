<script is:inline>
  // Scroll reveal with fallback
  const revealEls = document.querySelectorAll('.reveal');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); obs.unobserve(e.target); } });
  }, { threshold: 0, rootMargin: '0px 0px -40px 0px' });
  revealEls.forEach(el => obs.observe(el));
  setTimeout(() => revealEls.forEach(el => el.classList.add('revealed')), 400);

  // Form validation + submission
  const form = document.getElementById('consultation-form');
  const successPanel = document.getElementById('success-panel');

  form.addEventListener('submit', function(e) {
    e.preventDefault();

    // Validate platform selection
    const platforms = form.querySelectorAll('input[name="platforms"]:checked');
    const platformError = document.getElementById('platforms-error');
    if (platforms.length === 0) {
      platformError.classList.remove('hidden');
      platformError.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    } else {
      platformError.classList.add('hidden');
    }

    // Validate consent
    if (!form.consent.checked) {
      form.consent.focus();
      return;
    }

    // Basic HTML5 validation
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const btn = form.querySelector('button[type="submit"]');
    btn.textContent = 'Sending…';
    btn.disabled = true;

    const payload = {
      _template:        'email-consultation-confirmation.html',
      first_name:       form.first_name.value.trim(),
      last_name:        form.last_name.value.trim(),
      email:            form.email.value.trim(),
      phone:            form.phone.value.trim(),
      company:          form.company.value.trim(),
      role:             form.role.value,
      company_type:     form.company_type.value,
      monthly_ad_spend: form.monthly_ad_spend.value,
      platforms:        Array.from(platforms).map(cb => cb.value),
      challenge:        form.challenge.value,
      message:          form.message.value.trim(),
    };

    fetch('/api/submit', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify(payload),
    })
      .then(res => {
        if (!res.ok) throw new Error('Server error: ' + res.status);
        form.style.display = 'none';
        successPanel.style.display = 'block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
      })
      .catch(() => {
        btn.textContent = 'Book My Free Consultation →';
        btn.disabled = false;
        const errEl = document.getElementById('submit-error');
        errEl.classList.remove('hidden');
        errEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
  });
</script>
<style is:global>
#success-panel { display: none; }
</style>
