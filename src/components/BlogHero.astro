---
interface Props {
  category: string;
  title: string;
  subtitle: string;
  author: string;
  date: Date;
  readMinutes: number;
  heroGradient: string;
}
const { category, title, subtitle, author, date, readMinutes, heroGradient } = Astro.props;
// Format in UTC so a date-only frontmatter value (parsed as UTC midnight)
// doesn't roll back a day in negative-offset build environments.
const dateStr = date.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<div class="py-14 px-6" style={`background:${heroGradient}`}>
  <div class="max-w-3xl mx-auto text-center">
    <div class="flex items-center justify-center gap-2 mb-5 flex-wrap">
      <span
        class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider"
        style="background:rgba(255,255,255,.2);color:white;">{category}</span>
      <span class="text-blue-100 text-xs">{dateStr} · {readMinutes} min read</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4 leading-tight font-display">{title}</h1>
    <p class="text-blue-100 text-base leading-relaxed max-w-2xl mx-auto">{subtitle}</p>
    <div class="flex items-center justify-center gap-3 mt-6">
      <div
        class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold text-white flex-shrink-0"
        style="background:rgba(255,255,255,.25)">F42</div>
      <p class="text-blue-100 text-sm">{author}</p>
    </div>
  </div>
</div>
