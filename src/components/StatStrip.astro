---
interface Props {
  stats: { value: string; label: string }[];
}
const { stats } = Astro.props;
// Explicit map so Tailwind's scanner sees the literal class names (no dynamic purge).
const colClass =
  { 1: 'grid-cols-1', 2: 'grid-cols-2', 3: 'grid-cols-3' }[stats.length] ?? 'grid-cols-3';
---
{
  stats.length > 0 && (
    <div
      class="py-10 px-6 border-b"
      style="border-color:rgba(0,102,255,.08);background:rgba(255,255,255,.6)">
      <div class={`max-w-3xl mx-auto grid ${colClass} gap-4`}>
        {stats.map((s) => (
          <div class="stat-box">
            <p
              class="text-2xl font-bold mb-1 font-display"
              style="background:linear-gradient(135deg,#0066FF,#00B4D8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">
              {s.value}
            </p>
            <p class="text-xs text-slate-500">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  )
}
