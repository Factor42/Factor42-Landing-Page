---
// Shared site header — frosted glass, fixed. Used on all pages except the
// landing page (index), which keeps its own scroll-aware navbar.
---
<header class="fixed top-0 left-0 right-0 z-50 py-4 border-b site-header">
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
    <a href="/" class="text-2xl font-bold tracking-tight text-gray-900 font-display">
      Factor<span class="gradient-text-blue">42</span>
    </a>
    <nav class="hidden md:flex items-center gap-6" aria-label="Main navigation">
      <a href="/#services" class="text-sm text-slate-500 hover:text-gray-900 transition-colors">Services</a>
      <a href="/about" class="text-sm text-slate-500 hover:text-gray-900 transition-colors">About</a>
      <a href="/blog" class="text-sm text-slate-500 hover:text-gray-900 transition-colors">Blog</a>
      <a href="/careers" class="text-sm text-slate-500 hover:text-gray-900 transition-colors">Careers</a>
      <a href="/contact" class="text-sm text-slate-500 hover:text-gray-900 transition-colors">Contact</a>
      <a href="/consultation" class="btn-primary text-sm font-semibold text-white px-5 py-2.5 rounded-lg">Get Started</a>
    </nav>
  </div>
</header>
